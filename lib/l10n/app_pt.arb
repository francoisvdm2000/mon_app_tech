  "aboutElectricitePageTitle": "Referências eléctricas - no terreno",
  "elecSection1Title": "1) Bases (W, A, V, kW)",
  "elecSection1FormulasTitle": "3 fórmulas úteis",
  "elecSection1Formula1": "P (W) = U (V) × I (A)",
  "elecSection1Formula2": "I (A) = P (W) / U (V)",
  "elecSection1Formula3": "P (kW) = P (W) / 1000",
  "elecSection1FieldMarksTitle": "Pontos de referência",
  "elecSection1FieldMark1": "Mono 230V: 16A ≈ 3,7 kW | 32A ≈ 7,4 kW | 63A ≈ 14,5 kW",
  "elecSection1FieldMark2": "Três 400V: 16A ≈ 11 kW | 32A ≈ 22 kW | 63A ≈ 44 kW",
  "elecSection2Title": "2) Conectores (Schuko / P17 / PowerCON)",
  "elecSection2SchukoTitle": "Schuko (tomadas domésticas)",
  "elecSection2SchukoBullet1": "Tipicamente 16A max (≈ 3,7 kW a 230V).",
  "elecSection2SchukoBullet2": "Tenha cuidado com as tomadas eléctricas e as extensões: podem aquecer.",
  "elecSection2P17Title": "P17 / CEE (azul/vermelho)",
  "elecSection2P17Bullet1": "Azul: 230V mono (campismo, pequena distro).",
  "elecSection2P17Bullet2": "Vermelho: 400V trifásico (distro, alta potência).",
  "elecSection2PowerconTitle": "PowerCON (áudio/iluminação)",
  "elecSection2PowerconBullet1": "PowerCON TRUE1 = mais \"campo\" (bloqueio, IP).",
  "elecSection2PowerconBullet2": "Verificar a secção transversal e a proteção do cabo.",
  "elecSection3Title": "3) Mono / Tri (qual é a diferença)",
  "elecSection3Paragraph": "Mono = uma fase + neutro (230V). Tri = 3 fases (400V entre fases).",
  "elecSection3PitfallsTitle": "Armadilhas frequentes",
  "elecSection3Pitfall1": "Desequilíbrio de fases (uma fase sobrecarregada).",
  "elecSection3Pitfall2": "O neutro aquece se os harmónicos forem elevados (LEDs, reguladores de intensidade).",
  "elecSection3Pitfall3": "Solo ausente/duvidoso em alguns sítios.",
  "elecSection3MethodTitle": "Método simples",
  "elecSection3MethodBullet1": "Distribuir as cargas pesadas por L1/L2/L3.",
  "elecSection3MethodBullet2": "Monitorizar o neutro se houver muitos LEDs.",
  "elecSection3MethodBullet3": "Se possível, efetuar a medição com pinças.",
  "elecSection4Title": "4) Mesa rápida (16A → 400A)",
  "elecSection4MonoTitle": "Mono 230V (≈ U×I)",
  "elecSection4MonoCode": "16A ≈ 3,7 kW\n32A ≈ 7,4 kW\n63A ≈ 14,5 kW\n125A ≈ 28,8 kW\n200A ≈ 46 kW\n",
  "elecSection4TriTitle": "Três 400V (≈ √3×U×I)",
  "elecSection4TriCode": "16A ≈ 11 kW\n32A ≈ 22 kW\n63A ≈ 44 kW\n125A ≈ 86 kW\n200A ≈ 138 kW\n400A ≈ 277 kW\n",
  "elecSection4ImportantTitle": "Importante",
  "elecSection4ImportantBullet1": "Trata-se de ordens de grandeza (cosφ, harmónicos, perdas).",
  "elecSection4ImportantBullet2": "Validar sempre as protecções + secções + temperatura.",
  "elecSection5Title": "6) Segurança e armadilhas",
  "elecSection5DontDoTitle": "O que não fazer",
  "elecSection5DontDoBullet1": "Encadear tiras de alimentação/extensões a granel.",
  "elecSection5DontDoBullet2": "Misturar fases sem saber.",
