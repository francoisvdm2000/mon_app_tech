# Paramètres non-secrets (firebase-functions/params defineString).
# Copie ce fichier en `.env` (local) ou laisse le CLI te les demander au
# premier déploiement — il créera `.env.<project-id>` automatiquement.
# Les VRAIS secrets (clé privée Apple, JSON du compte de service Google) ne
# vont PAS ici : ils se définissent avec `firebase functions:secrets:set`.

# App Store Connect > Utilisateurs et accès > Intégrations > In-App Purchase
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=

# Identifiant numérique de l'app dans App Store Connect (App Information),
# requis pour la vérification en environnement Production.
APPLE_APP_APPLE_ID=

# E-mail du compte de service dédié à la souscription push Pub/Sub des
# notifications Google Play (voir RUNBOOK.md, étape Google Play RTDN).
PUBSUB_PUSH_SERVICE_ACCOUNT_EMAIL=
